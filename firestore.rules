rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bu kişisel uygulama sadece bu iki hesaba açık
    function isAllowedEmail() {
      return request.auth != null &&
        request.auth.token.email in ['altanmelihhh@gmail.com', 'emineay12@gmail.com'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && isAllowedEmail();
    }

    // Kullanıcı hesap belgesi
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Kullanıcının kendi alt koleksiyonları (dailyLogs, meals, supplementLogs, vb.)
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /userProfiles/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /userPrograms/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /userProgress/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /userSettings/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /nutritionPlans/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /calorieTracking/{docId} {
      allow read, write: if request.auth != null && isAllowedEmail() &&
        docId.matches(request.auth.uid + '_.*');
    }
    match /waterTracking/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /weightTracking/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /dailyLogs/{docId} {
      allow read, write: if request.auth != null && isAllowedEmail() &&
        docId.matches(request.auth.uid + '_.*');
    }
    match /exerciseHistory/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /bodyMeasurements/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /bodyComposition/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /progressPhotos/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /nutritionGoals/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
